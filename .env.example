# Optional alternatives to ~/.cdsapirc. Leave these commented if using .cdsapirc.
# CDSAPI_URL=https://cds.climate.copernicus.eu/api
# CDSAPI_KEY=YOUR_PERSONAL_ACCESS_TOKEN
# CDSAPI_RC=/absolute/path/to/your/.cdsapirc

# Optional data directory; otherwise config.yml controls it.
# BP_DATA_DIR=/absolute/path/to/data
# BP_CONFIG=/absolute/path/to/config.yml

# ECMWF open-data mirror: ecmwf, aws, google or azure.
# IFS_SOURCE=ecmwf

# Direct local archive locations (override config.yml).
# BP_ERA5_ROOT=/data3/ERA5
# BP_WRF_ROOT=/data1/tim/SkySightWRF
# BP_CACHE_MB=256
# BALLOONPREDICTOR_VENV=/absolute/path/to/your/environment
